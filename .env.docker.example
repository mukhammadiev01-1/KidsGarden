# Copy this file to .env.docker for Docker Compose deployment.
# Do not commit .env.docker.

# Backend runtime
NODE_ENV=production
PORT_API=3000
API_PORT=3000
CORS_ORIGIN=https://your-domain.example

# MongoDB Atlas stays external.
MONGO_PROD=mongodb+srv://USER:PASSWORD@CLUSTER/KidsGardenProd?retryWrites=true
MONGO_DEV=mongodb+srv://USER:PASSWORD@CLUSTER/KidsGarden?retryWrites=true

# Backend secrets. Use real values only in local .env or server secret storage.
SECRET_TOKEN=replace-me
OPENAI_API_KEY=replace-me
OPENAI_TRANSLATION_MODEL=gpt-4o-mini
TRANSLATION_MAX_CHARS=1000
TRANSLATION_DAILY_LIMIT_PER_USER=30
NAVER_MAPS_KEY_ID=replace-me
NAVER_MAPS_KEY=replace-me
REDIS_URL=

# Frontend public values consumed by docker-compose build/runtime.
CLIENT_PORT=7007
NEXT_PUBLIC_API_URL=https://api.your-domain.example
NEXT_PUBLIC_API_GRAPHQL_URL=https://api.your-domain.example/graphql
NEXT_PUBLIC_API_WS=wss://api.your-domain.example/graphql
NEXT_PUBLIC_SITE_URL=https://your-domain.example
NEXT_PUBLIC_NAVER_MAPS_KEY_ID=replace-me
NEXT_PUBLIC_KAKAO_MAP_JS_KEY=
NEXT_PUBLIC_KAKAO_REST_API_KEY=
NEXT_PUBLIC_KAKAO_REDIRECT_URI=
NEXT_PUBLIC_TELEGRAM_BOT_NAME=
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
