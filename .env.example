NODE_ENV=development

PORT_API=3000
PORT_BATCH=3001

MONGO_DEV=mongodb://127.0.0.1:27017/kidsgarden-dev
MONGO_PROD=mongodb+srv://USER:PASSWORD@HOST/kidsgarden-prod

SECRET_TOKEN=replace-with-long-random-jwt-secret

REDIS_URL=redis://localhost:6379

GOOGLE_CLIENT_ID=replace-with-google-client-id

KAKAO_REST_API_KEY=replace-with-kakao-rest-api-key
KAKAO_CLIENT_SECRET=

NAVER_MAPS_KEY_ID=replace-with-naver-client-id
NAVER_MAPS_KEY=replace-with-naver-client-secret

TELEGRAM_BOT_TOKEN=replace-with-telegram-bot-token

OPENAI_API_KEY=replace-with-openai-api-key
OPENAI_MODEL=gpt-5.4-mini
AI_ASSISTANT_ENABLED=true
AI_ASSISTANT_DAILY_LIMIT_GUEST=3
AI_ASSISTANT_DAILY_LIMIT_USER=15
AI_ASSISTANT_DAILY_LIMIT_ADMIN=25
AI_ASSISTANT_MAX_MESSAGE_LENGTH=800
AI_ASSISTANT_MAX_OUTPUT_TOKENS=350
AI_ASSISTANT_COOLDOWN_SECONDS=10
AI_ASSISTANT_OFF_TOPIC_GUARD=true
AI_ASSISTANT_MAX_HISTORY_MESSAGES=4
